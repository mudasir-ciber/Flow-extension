{
  "manifest_version": 3,
  "name": "AMJAD'S FLOW EXTENSION",
  "version": "1.0.0",
  "description": "Bulk prompt automation, character consistency anchor, and automatic image downloader for Google Flow.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "https://flow.google/*",
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://labs.google/*",
    "https://*.labs.google/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "AMJAD'S FLOW EXTENSION"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google/*",
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*",
        "https://*.labs.google/*"
      ],
      "js": ["inject-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flow.google/*",
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*",
        "https://*.labs.google/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
